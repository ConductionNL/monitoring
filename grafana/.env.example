# Grafana Keycloak OAuth – waarden uit Keycloak (niet committen)
# Je maakt hier geen nieuwe secrets: vul de client secret in die Keycloak al toont
# bij je client (realm Grafana, client "grafana" → tab Credentials).
#
# Kopieer naar .env, vul GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET in, draai: ./scripts/grafana-oauth-secret.sh
# Zie grafana/README.md

GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=
